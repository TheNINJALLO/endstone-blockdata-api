{
  "schema": 3,
  "project": "endstone-blockdata-api",
  "api": "0.5.1",
  "adapter_family": "minecraft-bedrock-26.40",
  "adapters": [
    {
      "bds": "1.26.40",
      "endstone": "0.11.7",
      "status": "source-adapter",
      "features": [
        "block_states",
        "block_writes",
        "block_actor_metadata",
        "canonical_block_actor_nbt",
        "complete_container_items",
        "nested_item_user_nbt",
        "container_save_nbt",
        "inventory_writes",
        "bundle_content_reads",
        "bundle_content_writes",
        "shelf_reads",
        "shelf_writes",
        "dirty_marking",
        "client_updates",
        "endstone_service",
        "live_python_bridge"
      ]
    }
  ],
  "not_claimed": [
    "byte-identical hidden general BlockActor::save/load ABI",
    "unverified arbitrary non-container actor NBT replacement"
  ],
  "policy": "fail-closed; exact runtime BDS build and mapped Endstone version required"
}
